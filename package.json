{
  "name": "@fleet/buckle",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "The LLM MITM gateway: context injection, key management, tracking, downstream federation, live overview.",
  "engines": {
    "bun": ">=1.3.4",
    "npm": ">=11.0.0"
  },
  "exports": {
    ".": "./src/index.ts",
    "./schemas": "./src/schemas/index.ts",
    "./openapi.json": "./openapi.json",
    "./deploy": "./deploy/front/front.main.ts"
  },
  "files": [
    "src",
    "deploy",
    "docs",
    "openapi.json",
    "AGENTS.md",
    "README.md"
  ],
  "scripts": {
    "test": "bun test",
    "test:smoke": "bun --bun playwright test --project=smoke",
    "test:e2e": "bun --bun playwright test --project=e2e",
    "test:federation": "bun --bun playwright test --project=federation",
    "gen:openapi": "bun tools/src/buckle.gen-openapi.ts",
    "check": "bun tools/src/buckle.check-laws.ts && bun run gen:openapi --check",
    "quality:lint": "qlty check --all --filter eslint --no-upgrade-check",
    "quality:smells": "qlty smells --all --no-upgrade-check",
    "quality:dead": "qlty check --all --filter knip --no-upgrade-check"
  },
  "dependencies": {
    "@earendil-works/chord": "1.5.0",
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-durable": "1.5.0",
    "@earendil-works/pi-schema": "1.5.0",
    "@fleet/health": "git+ssh://git@github.com/klh/fleet-health.git#v1.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/bun": "1.4.4",
    "@types/node": "26.6.6",
    "eslint": "10.8.0",
    "jiti": "2.6.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2"
  },
  "trustedDependencies": [
    "@google/genai",
    "protobufjs"
  ]
}
