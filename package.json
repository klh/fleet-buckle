{
  "name": "@fleet/buckle",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "The LLM MITM gateway: context injection, key management, tracking, downstream federation, live overview.",
  "engines": { "bun": ">=1.3.4", "npm": ">=11.0.0" },
  "bin": { "buckle": "src/server/buckle.server.bin.ts" },
  "exports": {
    ".": "./src/index.ts",
    "./schemas": "./src/schemas/index.ts",
    "./openapi.json": "./openapi.json",
    "./deploy": "./deploy/index.ts"
  },
  "files": ["src", "deploy", "docs", "openapi.json", "AGENTS.md", "README.md"],
  "scripts": {
    "test": "bun test",
    "test:smoke": "bun --bun playwright test --project=smoke",
    "test:e2e": "bun --bun playwright test --project=e2e",
    "test:federation": "bun --bun playwright test --project=federation",
    "gen:openapi": "bun tools/src/buckle.gen-openapi.ts",
    "check": "bun tools/src/buckle.check-laws.ts && bun run gen:openapi --check"
  },
  "dependencies": { "zod": "4.6.7" },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/bun": "1.4.4",
    "typescript": "5.9.3"
  }
}
