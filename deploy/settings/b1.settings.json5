// b1.settings.json5 — the REAL single-hub deploy: openrouter via the
// provider registry default endpoint, the fleet identity principals,
// no peers (the federated b1→b2→b3 topology is the TEST surface,
// test/deploy/settings). Composed over default.settings.json5.
{
  hub: { label: "b1" },
  access: {
    principals: [
      { id: "alice@fleet", kind: "human", groups: [] },
      { id: "bob@fleet", kind: "human", groups: [] },
      { id: "carol@fleet", kind: "developer", groups: ["platform"] },
      { id: "federation@fleet", kind: "service", groups: [] },
    ],
    grants: [
      {
        principal: "alice@fleet",
        scopes: ["models.list", "models.use"],
        limits: { max_rpm: 4 },
      },
      { principal: "bob@fleet", scopes: ["models.list", "models.use"] },
      {
        principal: "carol@fleet",
        scopes: ["models.list", "models.use", "stats.read", "tree.read"],
      },
      { principal: "federation@fleet", scopes: ["models.list"] },
    ],
  },
  providers: {
    // url/dialect default from the provider registry (the REAL endpoint)
    openrouter: { key: "/etc/buckle/keys/openrouter.key" },
  },
}
