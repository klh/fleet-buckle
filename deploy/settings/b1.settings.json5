{
  // b1.settings.json5 — the demo topology's head buckle: openrouter +
  // downstream peers b2, b3. Composed over default.settings.json5.
  hub: { label: "b1" },
  access: {
    principals: [
      { id: "alice@fleet", kind: "human", groups: [] },
      { id: "bob@fleet", kind: "human", groups: [] },

      { id: "carol@fleet", kind: "developer", groups: ["platform"] },
      { id: "federation@fleet", kind: "service", groups: [] },
    ],
    grants: [
      // own rows ONLY — the empty peer list (federated views ride grants)
      {
        principal: "alice@fleet",
        scopes: ["models.list", "models.use"],
        peers: [],
      },
      // own + b3's zai rows — the matrix's openrouter+zai cell
      {
        principal: "bob@fleet",
        scopes: ["models.list", "models.use"],
        peers: ["b3"],
      },
      {
        principal: "carol@fleet",
        scopes: ["models.list", "models.use", "stats.read", "tree.read"],
      },
      {
        principal: "federation@fleet",
        scopes: ["models.list", "stats.read", "tree.read"],
      },
    ],
  },
  providers: {
    openrouter: {
      url: "http://openrouter-stub:8080",
      dialect: "openai",
      key: "/etc/buckle/keys/openrouter.key",
    },
  },
  hubs: {
    // d — DOWNSTREAM ONLY: we pull their catalogs; we never call up.
    b2: {
      url: "http://buckle2:4111",
      token_file: "/etc/buckle/keys/peer-b2.token",
    },
    b3: {
      url: "http://buckle3:4111",
      token_file: "/etc/buckle/keys/peer-b3.token",
    },
  },
}
