{
  // b2.settings.json5 — ms copilot provider + downstream peer b3.
  hub: { label: "b2" },
  access: {
    principals: [
      { id: "carol@fleet", kind: "developer", groups: ["platform"] },
    ],
    grants: [
      {
        principal: "carol@fleet",
        scopes: ["models.list", "models.use", "stats.read", "tree.read"],
      },
    ],
  },
  providers: {
    mscopilot: {
      url: "http://mscopilot-stub:8080",
      dialect: "openai",
      key: "/etc/buckle/keys/mscopilot.key",
    },
  },
  hubs: {
    b3: {
      url: "http://buckle3:4111",
      token_file: "/etc/buckle/keys/peer-b3.token",
    },
  },
}
