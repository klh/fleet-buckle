// b1.rolling-v2.json5 — the NEW VERSION of unit b1 for the rolling
// deploy: a pure DIFF. Composed over b1.settings.json5 (mounted as
// BUCKLE_DEFAULTS for the v2 container): the unit, its provider, its
// principals and grants are inherited wholesale — only the version
// stamp is new, and healthz answers it BEFORE any traffic flips.
// The keys block is restated because b1 sits at the BOTTOM of this
// compose (the shared default layer's keys.dir does not ride here).
{
  hub: { version: "v2-rolling" },
  keys: {
    root: "/etc/buckle/keys/root.key",
    engine: "/etc/buckle/keys/engine.key",
    principals_dir: "/etc/buckle/keys",
  },
}
