// b1.rolling-v2.json5 — the NEW VERSION of unit b1 for the rolling
// deploy demo: same hub, version-stamped (healthz answers v2 before
// any traffic flips), no peers (the roll rides one unit's surface).
{
  hub: { label: "b1", version: "v2-rolling" },
  providers: {
    openrouter: {
      url: "http://openrouter-stub:8080",
      dialect: "openai",
      key: "/etc/buckle/keys/openrouter.key",
    },
  },
  access: {
    principals: [
      { id: "alice@fleet", kind: "human", groups: [] },
      { id: "bob@fleet", kind: "human", groups: [] },
      { id: "carol@fleet", kind: "developer", groups: ["platform"] },
      { id: "federation@fleet", kind: "service", groups: [] },
    ],
    grants: [
      {
        principal: "alice@fleet",
        scopes: ["models.list", "models.use"],
        peers: [],
        limits: { max_rpm: 4 },
      },
      {
        principal: "bob@fleet",
        scopes: ["models.list", "models.use"],
        peers: ["b3"],
      },
      {
        principal: "carol@fleet",
        scopes: [
          "models.list",
          "models.use",
          "stats.read",
          "tree.read",
        ],
      },
      {
        principal: "federation@fleet",
        scopes: ["models.list", "stats.read", "tree.read"],
      },
    ],
  },
}
