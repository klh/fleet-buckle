// azure.settings.json5 — the tabula-rasa hub for the ~50-dev Azure
// deployment: Entra-identified humans, Copilot BYOC seats, ONE GUI.
// What is deliberately ABSENT: provider keys (BYOC — no key ever
// exists for mscopilot on this unit), an engine (no litellm yet),
// lanes (slugs are free-form attribution). The over layer (mounted
// at /state/over.json5, BUCKLE_SETTINGS_OVER) is where /admin/hubs
// lands runtime edits.
{
  hub: {
    label: "azure",
    ports: { buckle: 4111 },
  },
  // compose service DNS name — default's 127.0.0.1:4000 is unreachable
  // from the buckle container (B02)
  engine: { url: "http://engine:4000" },
  keys: {
    // runtime-mounted engine master key (the live stack's path)
    engine: "/state/keys/engine.master.key",
    // the shared /state volume: GUI + admin principal keys (0600,
    // minted on the hub, never baked into images)
    principals_dir: "/state/keys",
  },
  access: {
    principals: [
      { id: "gui@azure", kind: "service", groups: [] },
      { id: "owner@azure", kind: "human", groups: [] },
    ],
    grants: [
      {
        principal: "gui@azure",
        scopes: ["admin", "models.list", "stats.read", "tree.read"],
      },
      { principal: "owner@azure", scopes: ["models.list", "models.use", "stats.read"] },
    ],
    tiers: [],
  },
  providers: {
    // BYOC by registry default: url+dialect+catalog headers resolve
    // from KNOWN_PROVIDERS; the credential is ALWAYS the caller's
    // /w/<lane>/<token> — nothing to configure here, ever
    mscopilot: {},
  },
  timeouts: {
    // the seat's /models rate limit runs minutes; keep serving the
    // last-good catalog for up to an hour of consecutive faults
    catalog_grace_ms: 3600000,
  },
}
