{
  "openapi": "3.1.0",
  "info": {
    "title": "@fleet/buckle",
    "version": "0.1.0",
    "description": "The LLM MITM gateway: context injection, key management, tracking, downstream federation, live overview."
  },
  "paths": {
    "/v1/models": {
      "get": {
        "summary": "Federated model list for the authenticated principal",
        "description": "Own providers' models (fetched, with verbatim provider metadata) plus every downstream peer's models the principal holds grants on — per-hop checked.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "type": "object",
                  "properties": {
                    "hub": {
                      "type": "string",
                      "minLength": 1
                    },
                    "models": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "minLength": 1
                          },
                          "origin": {
                            "oneOf": [
                              {
                                "type": "object",
                                "properties": {
                                  "kind": {
                                    "type": "string",
                                    "const": "provider"
                                  },
                                  "label": {
                                    "type": "string",
                                    "minLength": 1
                                  },
                                  "url": {
                                    "type": "string",
                                    "format": "uri"
                                  }
                                },
                                "required": [
                                  "kind",
                                  "label"
                                ],
                                "additionalProperties": false
                              },
                              {
                                "type": "object",
                                "properties": {
                                  "kind": {
                                    "type": "string",
                                    "const": "buckle"
                                  },
                                  "label": {
                                    "type": "string",
                                    "minLength": 1
                                  },
                                  "url": {
                                    "type": "string",
                                    "format": "uri"
                                  }
                                },
                                "required": [
                                  "kind",
                                  "label",
                                  "url"
                                ],
                                "additionalProperties": false
                              }
                            ]
                          },
                          "limits": {
                            "type": "object",
                            "properties": {
                              "max_concurrent": {
                                "type": "integer",
                                "exclusiveMinimum": 0,
                                "maximum": 9007199254740991
                              },
                              "max_per_ip": {
                                "type": "integer",
                                "exclusiveMinimum": 0,
                                "maximum": 9007199254740991
                              },
                              "max_rpm": {
                                "type": "integer",
                                "exclusiveMinimum": 0,
                                "maximum": 9007199254740991
                              }
                            },
                            "additionalProperties": false
                          },
                          "live": {
                            "type": "object",
                            "properties": {
                              "inflight": {
                                "type": "integer",
                                "minimum": 0,
                                "maximum": 9007199254740991
                              },
                              "tps": {
                                "type": "number",
                                "minimum": 0
                              }
                            },
                            "required": [
                              "inflight",
                              "tps"
                            ],
                            "additionalProperties": false
                          },
                          "meta": {
                            "type": "object",
                            "propertyNames": {
                              "type": "string"
                            },
                            "additionalProperties": {}
                          }
                        },
                        "required": [
                          "id",
                          "origin"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "hub",
                    "models"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "https://buckle.fleet/problems/1"
                    },
                    "kind": {
                      "type": "string",
                      "enum": [
                        "validation",
                        "unauthenticated",
                        "forbidden",
                        "not-found",
                        "conflict",
                        "rate-limited",
                        "unavailable",
                        "internal"
                      ]
                    },
                    "title": {
                      "type": "string",
                      "minLength": 1
                    },
                    "status": {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    },
                    "detail": {
                      "type": "string"
                    },
                    "errors": {},
                    "requestId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "retryAfter": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "type",
                    "kind",
                    "title",
                    "status"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
