{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  // The entry/project contract (the qlty.toml knip block points here).
  // The durable worker LIVES IN klh/fleet-worker now (see
  // docs/worker-moved.md); this repo is the gateway only. Verify with:
  // npx knip@5.88.1
  "workspaces": {
    ".": {
      // src/agents is the staged agent-job wave (wiring lands with the
      // server lift) — its files are entries until their consumer exists
      "entry": ["tools/src/*.ts", "test/**/*.ts", "src/agents/*.ts"],
      "project": ["src/**/*.ts", "deploy/front/*.ts", "tools/**/*.ts"],
    },
    // P0.2d owner-pilot login helper — own package, own install, manual
    // only (never in the Buckle image); not part of the gateway project.
    "test/manual/entra-login": {
      "entry": ["src/*.ts"],
      "project": ["src/**/*.ts"],
    },
  },
  "ignoreBinaries": ["qlty"],
}
