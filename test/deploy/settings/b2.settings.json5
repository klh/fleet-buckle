{
  // b2.settings.json5 — ms copilot provider + downstream peer b3.
  // the engine gate: when this file exists the buckle authenticates to
  // its litellm (master_key). Stub mode does NOT mint it (engines
  // open); real mode mints it into the mounted keys dir.
  keys: { engine: "/etc/buckle/keys/engine.master.key" },
  hub: { label: "b2" },
  // the compose network names this unit's engine + telemetry sink —
  // mode-independent facts (stub and real ride the same topology)
  engine: { url: "http://litellm2:4000", metrics_url: "http://litellm2:4002" },

  // CONTEXT INJECTION (e2e unit): b2 is the policy-carrying unit —
  // first-match-wins; the baseline stanza rides every originating
  // chat, the lane rule fires only on the /w/review-lane launch URL
  // (the stub's oracle answer proves the mutation rode through)
  context_policy: {
    rules: [
      {
        id: "lane-review",
        match: { lane: "review-lane" },
        text: "CONTEXT-MARK lane stanza (e2e oracle)",
      },
      {
        id: "b2-baseline",
        text: "CONTEXT-MARK b2 fleet stanza (e2e oracle)",
      },
    ],
  },
  // the /w/<slug> launch table (e2e): slug pins the model — the pin
  // wins over the body; the hub falls out of the federated catalog
  lanes: [{ id: "pin-haiku", model: "claude-haiku-5.5" }],
  telemetry: { otlp_url: "http://jaeger:4318" },
  access: {
    principals: [
      { id: "carol@fleet", kind: "developer", groups: ["platform"] },
      { id: "federation@fleet", kind: "service", groups: [] },
    ],
    grants: [
      {
        principal: "carol@fleet",
        // engine.passthrough: the catch-all (engine territory — litellm
        // admin faces) demands an explicit grant, never models.use alone
        scopes: [
          "models.list",
          "models.use",
          "stats.read",
          "tree.read",
          "engine.passthrough",
        ],
      },
      {
        principal: "federation@fleet",
        // models.use: this buckle RECEIVES hop traffic (b1 forwards
        // mscopilot-model chats here); models.use is checked per hop
        // against OUR registry
        scopes: ["models.list", "models.use", "stats.read", "tree.read"],
      },
    ],
  },
  providers: {
    // url/dialect default from the provider registry (the REAL
    // endpoint); the stub compose injects its stub url as the over layer
    mscopilot: { key: "/etc/buckle/keys/mscopilot.key" },
  },
  hubs: {
    b3: {
      url: "http://buckle3:4111",
      token_file: "/etc/buckle/keys/peer-b3.token",
    },
  },
}
