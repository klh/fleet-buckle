{
  // b3.settings.json5 — zai provider, no peers (the chain's tail).
  hub: { label: "b3" },
  access: {
    principals: [
      { id: "bob@fleet", kind: "human", groups: [] },

      { id: "carol@fleet", kind: "developer", groups: ["platform"] },
      { id: "federation@fleet", kind: "service", groups: [] },
    ],
    grants: [
      { principal: "bob@fleet", scopes: ["models.list", "models.use"] },
      {
        principal: "carol@fleet",
        scopes: ["models.list", "models.use", "stats.read", "tree.read"],
      },
      {
        principal: "federation@fleet",
        // models.use: this buckle RECEIVES hop traffic (b1 and b2 both
        // forward zai-model chats here); models.use is checked per hop
        // against OUR registry
        scopes: ["models.list", "models.use", "stats.read", "tree.read"],
      },
    ],
  },
  providers: {
    // url/dialect default from the provider registry (the REAL
    // endpoint); the stub compose injects its stub url as the over layer
    zai: { key: "/etc/buckle/keys/zai.key" },
  },
}
